from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field
from database import get_connection

import json
import subprocess
from datetime import datetime, timezone
from pathlib import Path


app = FastAPI(
    title="Linux Patching API",
    version="1.0.0",
)

    
class PatchRequest(BaseModel):
    packages: list[str] = Field(
        min_length=1,
        max_length=50,
        description="Package names to patch"
    )


BASE_DIR = Path(__file__).resolve().parent.parent
PATCH_DISCOVERY = BASE_DIR / "patching" / "discover.py"


@app.get("/health")
def health():
    return {
        "status": "healthy"
    }


@app.get("/api/assets")
def get_assets():
    connection = get_connection()

    try:
        with connection.cursor() as cursor:
            cursor.execute(
                """
                SELECT
                    id,
                    hostname,
                    ip_address,
                    username,
                    os,
                    os_version,
                    kernel_version,
                    status,
                    created_at,
                    updated_at
                FROM assets
                ORDER BY created_at DESC
                """
            )

            rows = cursor.fetchall()

            columns = [
                "id",
                "hostname",
                "ip_address",
                "username",
                "os",
                "os_version",
                "kernel_version",
                "status",
                "created_at",
                "updated_at",
            ]

            return [
                dict(zip(columns, row))
                for row in rows
            ]

    finally:
        connection.close()


@app.get("/api/assets/{asset_id}/telemetry")
def get_telemetry(asset_id: str):
    connection = get_connection()

    try:
        with connection.cursor() as cursor:
            cursor.execute(
                """
                SELECT
                    captured_at,
                    cpu_usage_percent,
                    memory_total_mb,
                    memory_used_mb,
                    memory_available_mb,
                    memory_usage_percent,
                    load_1m,
                    load_5m,
                    load_15m,
                    disk_total_gb,
                    disk_used_gb,
                    disk_free_gb,
                    disk_usage_percent,
                    network_data
                FROM telemetry_snapshots
                WHERE asset_id = %s
                ORDER BY captured_at DESC
                LIMIT 1
                """,
                (asset_id,),
            )

            row = cursor.fetchone()

            if row is None:
                raise HTTPException(
                    status_code=404,
                    detail="No telemetry found for this asset",
                )

            return {
                "captured_at": row[0],
                "cpu": {
                    "usage_percent": float(row[1]),
                },
                "memory": {
                    "total_mb": float(row[2]),
                    "used_mb": float(row[3]),
                    "available_mb": float(row[4]),
                    "usage_percent": float(row[5]),
                },
                "load": {
                    "1m": float(row[6]),
                    "5m": float(row[7]),
                    "15m": float(row[8]),
                },
                "disk": {
                    "total_gb": float(row[9]),
                    "used_gb": float(row[10]),
                    "free_gb": float(row[11]),
                    "usage_percent": float(row[12]),
                },
                "network": row[13],
            }

    finally:
        connection.close()


